        /**
         * Ponto central para processar dados e atualizar o dashboard e o calendário.
         */
        function processAndRenderDashboard() {
            if (globalGroups.length === 0) {
                console.log("Processamento adiado, grupos ainda não carregados.");
                return;
            }

            // 1. Agregar dados
            // { groupId: { group: {...}, requests: [...], totalPriority: 0, averagePriority: 0 } }
            const aggregatedData = {};

            // Inicializa com todos os grupos
            globalGroups.forEach(group => {
                aggregatedData[group.id] = {
                    group: group,
                    requests: [],
                    totalPriority: 0,
                    averagePriority: 0
                };
            });

            // Agrega solicitações válidas (prioridade > 0)
            globalRequests.forEach(req => {
                if (req.priority > 0 && aggregatedData[req.groupId]) {
                    aggregatedData[req.groupId].requests.push(req);
                    aggregatedData[req.groupId].totalPriority += req.priority;
                }
            });
            
            // Calcula Prioridade Média
            Object.values(aggregatedData).forEach(item => {
                if (item.requests.length > 0) {
                    item.averagePriority = item.totalPriority / item.requests.length;
                }
            });

            // 2. Classificar em listas
            const allDemands = Object.values(aggregatedData)
                                     .filter(item => item.requests.length > 0)
                                     .sort((a, b) => b.averagePriority - a.averagePriority); // Ordena por prioridade MÉDIA
            
            const commonRequests = allDemands.filter(item => item.requests.length > 2);
            const specificRequests = allDemands.filter(item => item.requests.length >= 1 && item.requests.length <= 2);

            // 3. Renderizar Métricas
            renderMetrics(allDemands, commonRequests, specificRequests);

            // 4. Renderizar Listas de Análise
            renderAnalysisLists(commonRequests, specificRequests);

            // 5. Renderizar Detalhes por Unidade
            renderUnitDetails();

            // 6. Renderizar Calendário Global
            renderGlobalCalendar(commonRequests, specificRequests);
        }

        /**
         * Renderiza os cards de métricas.
         */
        function renderMetrics(allDemands, common, specific) {
            document.getElementById('metricTotalGroups').textContent = globalGroups.length;
            document.getElementById('metricDemandGroups').textContent = allDemands.length;
            document.getElementById('metricCommonRequests').textContent = common.length;
            document.getElementById('metricSpecificRequests').textContent = specific.length;
        }

        /**
         * Renderiza as listas de Pedidos Comuns e Específicos.
         */
        function renderAnalysisLists(commonRequests, specificRequests) {
            const commonListEl = document.getElementById('commonRequestsList');
            const specificListEl = document.getElementById('specificRequestsList');
            
            const renderRow = (item) => `
                <tr>
                    <td class="px-4 py-3 text-sm font-medium text-slate-800">${item.group.number ? item.group.number.slice(-3) : 'S/N'}</td>
                    <td class="px-4 py-3 text-sm text-slate-600">${item.group.name}</td>
                    <td class="px-4 py-3 text-sm text-slate-600 text-center">${item.requests.length}</td>
                    <td class="px-4 py-3 text-sm text-slate-600 text-center">${item.averagePriority.toFixed(2)}</td>
                </tr>
            `;

            commonListEl.innerHTML = commonRequests.length > 0 
                ? commonRequests.map(renderRow).join('') 
                : '<tr><td colspan="4" class="p-4 text-center text-slate-500">Nenhum pedido comum.</td></tr>';
            
            specificListEl.innerHTML = specificRequests.length > 0
                ? specificRequests.map(renderRow).join('')
                : '<tr><td colspan="4" class="p-4 text-center text-slate-500">Nenhum pedido específico.</td></tr>';
        }

        /**
         * Renderiza a tabela de detalhes por unidade.
         */
        function renderUnitDetails() {
            const unitDetails = {};

            globalRequests.forEach(req => {
                if (req.priority > 0 && req.unitName) { // Garante que unitName exista
                    if (!unitDetails[req.unitName]) {
                        unitDetails[req.unitName] = {
                            count: 0,
                            totalPriority: 0
                        };
                    }
                    unitDetails[req.unitName].count++;
                    unitDetails[req.unitName].totalPriority += req.priority;
                }
            });

            const sortedUnits = Object.keys(unitDetails).sort();
            const tableBody = document.getElementById('unitDetailsList');

            if (sortedUnits.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-slate-500">Nenhuma solicitação registrada.</td></tr>';
                return;
            }

            tableBody.innerHTML = sortedUnits.map(unitName => {
                const data = unitDetails[unitName];
                const average = (data.totalPriority / data.count).toFixed(1);
                return `
                    <tr>
                        <td class="px-4 py-3 text-sm font-medium text-slate-800">${unitName}</td>
                        <td class="px-4 py-3 text-sm text-slate-600">${data.count}</td>
                        <td class="px-4 py-3 text-sm text-slate-600">${data.totalPriority}</td>
                        <td class="px-4 py-3 text-sm text-slate-600">${average}</td>
                    </tr>
                `;
            }).join('');
        }

        /**
         * Distribui a lista de demandas pelos 12 meses.
         * @param {Array} demands - Lista de demandas (comuns ou específicas)
         * @param {Array} monthsSchedule - Array de 12 meses para preencher
         */
        function distributeDemands(demands, monthsSchedule) {
            demands.forEach((demand, index) => {
                const monthIndex = index % 12; // Distribuição "round-robin"
                monthsSchedule[monthIndex].push(demand);
            });
        }

        /**
         * Renderiza o calendário global mês a mês.
         */
        function renderGlobalCalendar(commonRequests, specificRequests) {
            const calendarArea = document.getElementById('calendar-print-area');
            const MONTHS_ORDER = [
                "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
                "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"
            ];

            // Cria a estrutura dos 12 meses
            let monthsSchedule = MONTHS_ORDER.map(() => ({
                common: [],
                specific: []
            }));

            // Distribui os pedidos comuns (que já estão ordenados por prioridade MÉDIA)
            distributeDemands(commonRequests, monthsSchedule.map(m => m.common));
            
            // Distribui os pedidos específicos (que já estão ordenados por prioridade MÉDIA)
            distributeDemands(specificRequests, monthsSchedule.map(m => m.specific));

            // Renderiza o HTML
            calendarArea.innerHTML = MONTHS_ORDER.map((monthName, index) => {
                const monthData = monthsSchedule[index];
                
                const renderCard = (item, isCommon) => {
                    // Obtém a lista de nomes das unidades interessadas
                    const interestedUnits = item.requests.map(r => r.unitName).join(', ');
                    
                    return `
                    <div class="calendar-card border ${isCommon ? 'border-blue-300 bg-blue-50' : 'border-purple-300 bg-purple-50'} rounded-lg p-3 shadow-sm mb-2 break-inside-avoid">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-sm text-slate-800">${item.group.number ? item.group.number.slice(-3) : 'S/N'}</span>
                            <span class="text-xs ${isCommon ? 'text-blue-700' : 'text-purple-700'} font-medium">
                                ${isCommon ? 'COMUM' : 'ESPECÍFICO'}
                            </span>
                        </div>
                        <p class="text-sm text-slate-700 mt-1 font-medium">${item.group.name}</p>
                        <div class="text-xs text-slate-500 mt-2 flex justify-between items-center">
                             <span>Média: <strong>${item.averagePriority.toFixed(1)}</strong></span>
                             <span>Qtd: <strong>${item.requests.length}</strong></span>
                        </div>
                        <div class="text-xs text-slate-600 mt-2 pt-1 border-t border-slate-200">
                            <span class="font-semibold">Interessados:</span> ${interestedUnits}
                        </div>
                    </div>
                `};

                const commonHtml = monthData.common.length > 0 
                    ? monthData.common.map(item => renderCard(item, true)).join('')
                    : '<p class="text-sm text-slate-500 italic">Nenhum pedido comum este mês.</p>';
                
                const specificHtml = monthData.specific.length > 0
                    ? monthData.specific.map(item => renderCard(item, false)).join('')
                    : '<p class="text-sm text-slate-500 italic">Nenhum pedido específico este mês.</p>';

                return `
                    <div class="calendar-month mb-8">
                        <h3 class="text-xl font-semibold text-blue-800 border-b-2 border-blue-200 pb-2 mb-4">${monthName} ${YEAR}</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Coluna Pedidos Comuns -->
                            <div class="space-y-3">
                                <h4 class="text-lg font-semibold text-slate-700 border-b border-gray-200 pb-1 mb-2">Pedidos Comuns</h4>
                                <div class="space-y-3">${commonHtml}</div>
                            </div>
                            <!-- Coluna Pedidos Específicos -->
                            <div class="space-y-3">
                                <h4 class="text-lg font-semibold text-slate-700 border-b border-gray-200 pb-1 mb-2">Pedidos Específicos</h4>
                                <div class="space-y-3">${specificHtml}</div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // --- Ponto de Entrada ---
        // Garante que o script só rode após o HTML estar completo
        document.addEventListener('DOMContentLoaded', initializeApp);

    </script>

</body>
</html>
