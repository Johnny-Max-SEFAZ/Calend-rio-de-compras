        /**
         * Configura o listener de autenticação do Firebase.
         */
        function setupAuthListener() {
            const authStatusEl = document.getElementById('authStatus');
            authStatusEl.textContent = 'Autenticando...';

            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    console.log("Usuário autenticado:", user.uid);
                    userId = user.uid;
                    authStatusEl.textContent = 'Online';
                    authStatusEl.className = 'text-xs text-green-300';
                    document.getElementById('currentUserDisplay').textContent = `UserID: ${userId.substring(0, 6)}...`;

                    // Carregar perfil do usuário
                    await loadUserProfile();
                    
                    // Iniciar listeners do Firestore
                    setupGroupsListener();
                    setupAllRequestsListener();
                    setupMyRequestsListener(); 

                } else {
                    console.log("Usuário não autenticado, tentando login...");
                    authStatusEl.textContent = 'Offline';
                    authStatusEl.className = 'text-xs text-red-300';
                    await signInUser();
                }
            }, (error) => {
                console.error("Erro no listener de autenticação:", error);
                authStatusEl.textContent = 'Erro de Auth';
            });
        }

        /**
         * Tenta autenticar o usuário, primeiro com token, depois anonimamente.
         */
        async function signInUser() {
            try {
                if (initialAuthToken) {
                    console.log("Autenticando com token...");
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    console.log("Autenticando anonimamente...");
                    await signInAnonymously(auth);
                }
            } catch (error) {
                console.error("Erro ao autenticar:", error);
                document.getElementById('authStatus').textContent = 'Falha no Login';
            }
        }

