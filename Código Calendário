        function setupMyRequestsListener() {
            if (!userId) return;
            
            // Se não tem unidade definida, não carrega nada (ou limpa)
            if (!userUnitName) {
                userRequests = {};
                renderMyRequestsTable();
                return;
            }

            // Cancela listener anterior se existir (para não misturar dados ao trocar unidade)
            if (myRequestsUnsubscribe) {
                myRequestsUnsubscribe();
                myRequestsUnsubscribe = null;
            }

            const requestsCollection = collection(db, `artifacts/${appId}/public/data/requests`);
            // Query busca por ano e usuário (a filtragem por unidade será feita em memória para evitar erros de índice)
            const q = query(requestsCollection, where("year", "==", YEAR), where("userId", "==", userId));

            myRequestsUnsubscribe = onSnapshot(q, (snapshot) => {
                console.log(`Recebidas ${snapshot.docs.length} solicitações do usuário.`);
                userRequests = {}; // Limpa o cache local
                
                snapshot.docs.forEach(doc => {
                    const data = doc.data();
                    // FILTRAGEM CRÍTICA: Só aceita dados da unidade atual
                    if (data.unitName === userUnitName) {
                        userRequests[data.groupId] = {
                            id: doc.id,
                            priority: data.priority
                        };
                    }
                });
                
                // Atualiza a tabela de "Minhas Solicitações"
                renderMyRequestsTable();

            }, (error) => {
