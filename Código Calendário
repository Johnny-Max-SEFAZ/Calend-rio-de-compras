        /**
         * Salva todas as alterações pendentes em "Minhas Solicitações" em um batch.
         */
        async function saveAllMyRequests() {
            if (!userUnitName) {
                alert("Por favor, configure sua unidade antes de salvar.");
                document.getElementById('profileModal').classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('saveAllMyRequests');
            const originalBtnContent = btn.innerHTML;
            
            // Mudar estado do botão para "Carregando"
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> <span>Salvando...</span>';
            if (typeof lucide !== 'undefined') { lucide.createIcons(); }

            const selects = document.querySelectorAll('.priority-select');
            const batch = writeBatch(db);
            let changesCount = 0;

            selects.forEach(select => {
                const newPriority = parseInt(select.value, 10);
                const originalPriority = parseInt(select.dataset.originalValue, 10);
                
                // Salva apenas se o valor mudou
                if (newPriority === originalPriority) return;

                changesCount++;
                const groupId = select.dataset.groupId;
                const existingRequest = userRequests[groupId];

                const requestData = {
                    userId: userId,
                    unitName: userUnitName,
                    groupId: groupId,
                    year: YEAR,
                    priority: newPriority
                };

                if (existingRequest && existingRequest.id) {
                    // Atualiza (ou deleta se for 0)
                    const requestRef = doc(db, `artifacts/${appId}/public/data/requests`, existingRequest.id);
                    if (newPriority > 0) {
                        batch.update(requestRef, { priority: newPriority, unitName: userUnitName });
                    } else {
                        // Se a prioridade for 0, remove a solicitação
                        batch.delete(requestRef);
                    }
                } else if (newPriority > 0) {
                    // Cria nova (só se prioridade > 0)
                    const requestRef = doc(collection(db, `artifacts/${appId}/public/data/requests`));
                    batch.set(requestRef, requestData);
                }
            });

            if (changesCount === 0) {
                // Reverter botão
                btn.disabled = false;
                btn.innerHTML = originalBtnContent;
                alert("Nenhuma alteração para salvar.");
                return;
            }

            try {
                await batch.commit();
                console.log(`Batch salvo com ${changesCount} alterações.`);
                
                // Feedback de Sucesso no Botão
                btn.classList.remove('bg-blue-800', 'hover:bg-blue-700');
                btn.classList.add('bg-green-600', 'hover:bg-green-500');
                btn.innerHTML = '<i data-lucide="check" class="w-5 h-5"></i> <span>Salvo!</span>';
                if (typeof lucide !== 'undefined') { lucide.createIcons(); }

                // Reverter após 2 segundos
                setTimeout(() => {
                    btn.classList.add('bg-blue-800', 'hover:bg-blue-700');
                    btn.classList.remove('bg-green-600', 'hover:bg-green-500');
                    btn.innerHTML = originalBtnContent;
                    btn.disabled = false;
                    if (typeof lucide !== 'undefined') { lucide.createIcons(); }
                }, 2000);

            } catch (error) {
                console.error("Erro ao salvar solicitações:", error);
                alert("Ocorreu um erro ao salvar. Tente novamente.");
                btn.disabled = false;
                btn.innerHTML = originalBtnContent;
            }
        }

