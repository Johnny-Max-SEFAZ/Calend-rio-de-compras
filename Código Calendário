        /**
         * Sincroniza a lista de grupos padrão com o Firestore.
         * Adiciona grupos que não existem (baseado no 'number' - últimos 3 dígitos).
         * Atualiza nomes de grupos que existem mas estão diferentes.
         * Tenta corrigir números antigos (6 dígitos) para 3 dígitos se encontrar correspondência.
         */
        async function syncDefaultGroups() {
            const button = document.getElementById('syncDefaultGroups');
            button.disabled = true;
            button.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Sincronizando...';
            if (typeof lucide !== 'undefined') { lucide.createIcons(); } 

            console.log("Iniciando sincronização dos grupos padrão...");
            
            // 1. Criar um mapa dos grupos existentes no DB para fácil consulta
            // Usamos os últimos 3 dígitos como chave para normalizar
            const existingGroupsMap = new Map();
            globalGroups.forEach(group => {
                const normalizedNum = group.number ? group.number.slice(-3) : "000";
                existingGroupsMap.set(normalizedNum, group);
            });

            console.log(`Encontrados ${existingGroupsMap.size} grupos existentes no DB.`);

            const groupsCollection = collection(db, `artifacts/${appId}/public/data/groups`);
            const batch = writeBatch(db);
            let addedCount = 0;
            let updatedCount = 0;

            // 2. Iterar sobre a lista padrão (que já está com 3 dígitos)
            for (const groupData of DEFAULT_GROUPS_LIST) {
                const [shortNumber, name] = groupData;
                
                const existingGroup = existingGroupsMap.get(shortNumber);

                if (!existingGroup) {
                    // Grupo não existe no DB (nem com 3, nem com 6 dígitos terminando nestes 3), então adiciona
                    const newDocRef = doc(groupsCollection);
                    batch.set(newDocRef, { number: shortNumber, name: name });
                    addedCount++;
                } else {
                    // Grupo existe. Verifica se precisa atualizar (nome ou número antigo)
                    let needsUpdate = false;
                    const updates = {};

                    // Se o nome for diferente, atualiza
                    if (existingGroup.name !== name) {
                        updates.name = name;
                        needsUpdate = true;
                    }

                    // Se o número no banco for diferente do curto (ex: banco tem '000400', lista tem '400')
                    // Atualiza para o formato curto
                    if (existingGroup.number !== shortNumber) {
                        updates.number = shortNumber;
                        needsUpdate = true;
                    }

                    if (needsUpdate) {
                        const groupRef = doc(db, `artifacts/${appId}/public/data/groups`, existingGroup.id);
                        batch.update(groupRef, updates);
                        updatedCount++;
                    }
                }
            }

            if (addedCount === 0 && updatedCount === 0) {
                alert("O banco de dados de grupos já está sincronizado. Nenhuma alteração foi necessária.");
                button.disabled = false;
                button.innerHTML = '<i data-lucide="refresh-cw" class="w-5 h-5"></i> Sincronizar Grupos Padrão';
                if (typeof lucide !== 'undefined') { lucide.createIcons(); } 
                return;
            }

            // 3. Executar o batch
            try {
                await batch.commit();
                const message = `Sincronização concluída!\n- ${addedCount} grupos novos adicionados.\n- ${updatedCount} grupos existentes atualizados/corrigidos.`;
                console.log(message);
                alert(message);
            } catch (error) {
                console.error("Erro na sincronização em lote:", error);
                alert("Ocorreu um erro ao sincronizar os grupos.");
            }

            button.disabled = false;
            button.innerHTML = '<i data-lucide="refresh-cw" class="w-5 h-5"></i> Sincronizar Grupos Padrão';
            if (typeof lucide !== 'undefined') { lucide.createIcons(); } 
        }


