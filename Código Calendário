            const sortedSecretarias = [...SECRETARIAS_LIST].sort((a, b) => a.localeCompare(b));
            sortedSecretarias.forEach(name => {
                const option = document.createElement('option');
                option.value = name;
                option.textContent = name;
                select.appendChild(option);
            });
        }

