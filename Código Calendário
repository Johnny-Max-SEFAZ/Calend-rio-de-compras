        // --- IMPORTAÇÃO CSV ---

        function setupCSVImport() {
            const fileInput = document.getElementById('csvFileInput');
            const btnProcess = document.getElementById('btnProcessImport');
            const modal = document.getElementById('importConfirmModal');
            
            // Botões do modal
            const btnCancel = document.getElementById('btnImportCancel');
            const btnSkip = document.getElementById('btnImportSkipExisting');
            const btnOverwrite = document.getElementById('btnImportOverwrite');

            let parsedGroupsToAdd = [];
            let parsedGroupsToUpdate = [];

            btnProcess.addEventListener('click', () => {
                const file = fileInput.files[0];
                if (!file) {
                    alert("Por favor, selecione um arquivo CSV.");
                    return;
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    const content = e.target.result;
                    const lines = content.split(/\r?\n/);
                    
                    parsedGroupsToAdd = [];
                    parsedGroupsToUpdate = [];

                    const existingMap = new Map();
                    globalGroups.forEach(g => existingMap.set(g.number.slice(-3), g));

                    lines.forEach(line => {
                        if (!line.trim()) return;
                        
                        // Tenta separar por ponto e vírgula ou vírgula
                        let parts = line.split(';');
                        if (parts.length < 2) parts = line.split(',');
                        
                        if (parts.length >= 2) {
                            let num = parts[0].trim();
                            let name = parts[1].trim();
                            
                            // Normaliza número para 3 dígitos se possível
                            if (num.length > 3) num = num.slice(-3);
                            
                            // Ignora cabeçalho se parecer cabeçalho
                            if (num.toLowerCase().includes('grupo') || name.toLowerCase().includes('nome')) return;

                            if (num && name) {
                                if (existingMap.has(num)) {
                                    parsedGroupsToUpdate.push({ id: existingMap.get(num).id, number: num, name: name });
                                } else {
                                    parsedGroupsToAdd.push({ number: num, name: name });
                                }
                            }
                        }
                    });

                    if (parsedGroupsToUpdate.length > 0) {
                        // Exibe modal de conflito
                        document.getElementById('importConflictMessage').innerHTML = 
                            `Encontramos <strong>${parsedGroupsToUpdate.length}</strong> grupos que já existem no sistema e <strong>${parsedGroupsToAdd.length}</strong> novos.`;
                        modal.classList.remove('hidden');
                    } else if (parsedGroupsToAdd.length > 0) {
                        // Só novos, processa direto
                        processBatchImport(parsedGroupsToAdd, []);
                    } else {
                        alert("Nenhum grupo válido encontrado ou todos já estão atualizados.");
                    }
                };
                reader.readAsText(file);
            });

            btnCancel.addEventListener('click', () => {
                modal.classList.add('hidden');
                fileInput.value = '';
            });

            btnSkip.addEventListener('click', () => {
                processBatchImport(parsedGroupsToAdd, []); // Passa array vazio de updates
                modal.classList.add('hidden');
            });

            btnOverwrite.addEventListener('click', () => {
                processBatchImport(parsedGroupsToAdd, parsedGroupsToUpdate);
                modal.classList.add('hidden');
            });
        }

        async function processBatchImport(toAdd, toUpdate) {
            if (toAdd.length === 0 && toUpdate.length === 0) return;

            const btn = document.getElementById('btnProcessImport');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Importando...';
            if (typeof lucide !== 'undefined') lucide.createIcons();

            const totalOps = toAdd.length + toUpdate.length;
            console.log(`Iniciando importação: ${toAdd.length} novos, ${toUpdate.length} atualizações.`);

            // Firestore batch limit is 500. We must chunk.
            const BATCH_SIZE = 450; 
            const allOps = [
                ...toAdd.map(g => ({ type: 'add', data: g })),
                ...toUpdate.map(g => ({ type: 'update', data: g }))
            ];

            try {
                for (let i = 0; i < allOps.length; i += BATCH_SIZE) {
                    const batch = writeBatch(db);
                    const chunk = allOps.slice(i, i + BATCH_SIZE);

                    chunk.forEach(op => {
                        if (op.type === 'add') {
                            const ref = doc(collection(db, `artifacts/${appId}/public/data/groups`));
                            batch.set(ref, op.data);
                        } else {
                            const ref = doc(db, `artifacts/${appId}/public/data/groups`, op.data.id);
                            batch.update(ref, { name: op.data.name });
                        }
                    });

                    await batch.commit();
                    console.log(`Lote de ${chunk.length} processado.`);
                }

                alert(`Importação concluída com sucesso!\n${toAdd.length} adicionados.\n${toUpdate.length} atualizados.`);
                document.getElementById('csvFileInput').value = '';

            } catch (error) {
                console.error("Erro na importação:", error);
                alert("Erro ao importar dados. Verifique o console.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }
        }

