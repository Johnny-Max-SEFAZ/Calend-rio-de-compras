        /**
         * Gera e baixa o relatório consolidado em CSV.
         */
        function exportReport() {
            if (!globalGroups.length || !globalRequests.length) {
                alert("Ainda não há dados suficientes para gerar o relatório.");
                return;
            }

            // 1. Preparar Cabeçalho
            const sortedUnits = [...SECRETARIAS_LIST].sort((a, b) => a.localeCompare(b));
            let csvContent = "Nº Grupo;Nome do Grupo;" + sortedUnits.join(";") + "\n";

            // 2. Preparar Mapa de Dados
            const requestsMap = {};
            globalRequests.forEach(req => {
                if (req.priority > 0 && req.unitName) {
                    if (!requestsMap[req.groupId]) {
                        requestsMap[req.groupId] = {};
                    }
                    requestsMap[req.groupId][req.unitName] = req.priority;
                }
            });

            // 3. Iterar sobre todos os grupos para criar as linhas
            globalGroups.forEach(group => {
                const groupNum = group.number ? group.number.slice(-3) : "S/N";
                const groupName = group.name.replace(/;/g, ",");
                
                let row = `${groupNum};${groupName}`;
                
                sortedUnits.forEach(unit => {
                    const priority = (requestsMap[group.id] && requestsMap[group.id][unit]) 
                                     ? requestsMap[group.id][unit] 
                                     : "";
                    row += `;${priority}`;
                });
                
                csvContent += row + "\n";
            });

            // 4. Criar Blob e Baixar
            const blob = new Blob(["\ufeff" + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            
            const link = document.createElement("a");
            link.setAttribute("href", url);
