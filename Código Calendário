<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendário de Compras 2026 - Prefeitura de Curvelo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons (Versão Estável) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        /* --- Estilos de Impressão --- */
        @media print {
            /* Oculta elementos estruturais da navegação e controle */
            header, nav, #profileModal, #deleteConfirmModal, #importConfirmModal, .no-print { 
                display: none !important; 
            }

            /* Configurações do corpo para impressão */
            body {
                background-color: white;
                color: black;
                font-size: 12pt;
            }

            /* Garante que a área principal ocupe tudo */
            main {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                max-width: none !important;
                box-shadow: none !important;
            }

            /* Oculta todas as abas... */
            .tab-content {
                display: none !important;
            }

            /* ...Exceto a aba do calendário, que forçamos a aparecer */
            #tab-calendario {
                display: block !important;
                visibility: visible !important;
            }

            /* Remove sombras e bordas dos containers internos para economizar tinta */
            #tab-calendario .bg-white {
                box-shadow: none !important;
                border: none !important;
            }

            /* Ajustes nos cards do mês para não quebrar página no meio */
            .calendar-month {
                page-break-inside: avoid;
                border: 1px solid #ccc;
                margin-bottom: 20px;
                padding: 10px;
            }
            
            /* Garante cores de fundo (para distinguir comuns/específicos) */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

        /* Estilo base para a aba ativa */
        .tab-button {
            border-bottom: 4px solid transparent;
        }
        .tab-button.active {
            border-bottom-color: #1d4ed8; /* blue-800 */
            color: #1d4ed8;
        }
    </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800">

    <!-- Cabeçalho Fixo -->
    <header class="w-full bg-[#004a91] text-white shadow-md p-4 flex justify-between items-center no-print">
        <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
            <h1 class="text-xl font-semibold">Calendário de Compras 2026 - Prefeitura de Curvelo</h1>
        </div>
        <div class="flex items-center gap-4">
            <span id="currentUserDisplay" class="text-sm">Carregando...</span>
            <button id="editProfileButton" class="text-sm flex items-center gap-1 bg-white/20 hover:bg-white/30 px-3 py-1 rounded-md transition-colors">
                <i data-lucide="building-2" class="w-4 h-4"></i>
                <span id="currentUnitDisplay">Selecione sua Unidade</span>
            </button>
            <span id="authStatus" class="text-xs"></span>
        </div>
    </header>

    <!-- Navegação por Abas -->
    <nav class="w-full bg-white shadow-sm border-b border-gray-200 no-print">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center gap-8">
                <button id="btn-tab-solicitacoes" class="tab-button active text-slate-600 hover:text-blue-700 py-4 px-2" data-tab="tab-solicitacoes">
                    <i data-lucide="edit" class="w-4 h-4 inline-block mr-1"></i>
                    Minhas Solicitações
                </button>
                <button id="btn-tab-calendario" class="tab-button text-slate-600 hover:text-blue-700 py-4 px-2" data-tab="tab-calendario">
                    <i data-lucide="calendar" class="w-4 h-4 inline-block mr-1"></i>
                    Calendário Global
                </button>
                <!-- Abas Administrativas (Visíveis apenas para Fazenda) -->
                <button id="btn-tab-grupos" class="tab-button text-slate-600 hover:text-blue-700 py-4 px-2 hidden" data-tab="tab-grupos">
                    <i data-lucide="list-checks" class="w-4 h-4 inline-block mr-1"></i>
                    Grupos Licitatórios
                </button>
                <button id="btn-tab-analise" class="tab-button text-slate-600 hover:text-blue-700 py-4 px-2 hidden" data-tab="tab-analise">
                    <i data-lucide="pie-chart" class="w-4 h-4 inline-block mr-1"></i>
                    Análise de Demandas
                </button>
            </div>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="max-w-7xl mx-auto p-4 w-full">

        <!-- Aba: Minhas Solicitações -->
        <div id="tab-solicitacoes" class="tab-content space-y-6">
            <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                <h2 class="text-2xl font-semibold text-slate-700 mb-4">Minhas Solicitações de Demanda (Ano: 2026)</h2>
                <p class="text-slate-600 mb-6">
                    Para cada grupo licitatório abaixo, indique seu nível de prioridade (de 1 a 10).
                    Selecione "0" se não houver interesse de contratação para sua unidade.
                </p>

                <!-- Filtros e Controles -->
                <div class="flex justify-between items-center mb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="search" class="w-5 h-5 text-gray-400"></i>
                        <input type="text" id="filterMyRequests" placeholder="Filtrar por nome ou nº do grupo..." class="border border-gray-300 rounded-md px-3 py-2 w-72 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div class="flex items-center gap-4">
                        <label class="flex items-center gap-2 text-sm text-slate-600">
                            <input type="checkbox" id="showOnlyPending" class="rounded text-blue-600 focus:ring-blue-500">
                            Mostrar apenas não preenchidos
                        </label>
                        <button id="saveAllMyRequests" class="bg-blue-800 hover:bg-blue-700 text-white font-medium px-5 py-2 rounded-lg shadow-sm transition-all duration-200 flex items-center gap-2 min-w-[180px] justify-center">
                            <i data-lucide="save" class="w-5 h-5"></i>
                            <span>Salvar Alterações</span>
                        </button>
                    </div>
                </div>

                <!-- Tabela de Solicitações -->
                <div class="overflow-hidden border border-gray-200 rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Nº Grupo</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Grupo Licitatório</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-48">Prioridade (0 a 10)</th>
                            </tr>
                        </thead>
                        <tbody id="myRequestsTable" class="bg-white divide-y divide-gray-200">
                            <!-- Linhas serão inseridas por JS -->
                            <tr>
                                <td colspan="3" class="px-6 py-4 text-center text-gray-500">
                                    <div class="flex items-center justify-center gap-2">
                                        <i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i>
                                        Carregando grupos...
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Aba: Calendário Global -->
        <div id="tab-calendario" class="tab-content space-y-6 hidden">
            <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                <div class="flex justify-between items-center mb-6 no-print">
                    <h2 class="text-2xl font-semibold text-slate-700">Calendário Global de Licitações 2026</h2>
                    <button id="printCalendarButton" class="bg-blue-800 hover:bg-blue-700 text-white font-medium px-5 py-2 rounded-lg shadow-sm transition-colors flex items-center gap-2">
                        <i data-lucide="printer" class="w-5 h-5"></i>
                        Imprimir
                    </button>
                </div>
                <p class="text-slate-600 mb-6 no-print">
                    O calendário é gerado automaticamente, distribuindo os grupos com <strong>maior prioridade média</strong> pelos meses.
                </p>

                <!-- Área de Impressão do Calendário -->
                <div id="calendar-print-area" class="space-y-8">
                    <!-- Meses serão preenchidos pelo JS -->
                </div>

            </div>
        </div>

        <!-- Aba: Grupos Licitatórios (Admin - Restrito) -->
        <div id="tab-grupos" class="tab-content space-y-6 hidden">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- Coluna da Esquerda: Ações -->
                <div class="md:col-span-1 space-y-6">
                    
                    <!-- Card de Edição Manual -->
                    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 sticky top-6">
                        <h2 class="text-2xl font-semibold text-slate-700 mb-4">Editar / Adicionar</h2>
                        <form id="groupForm" class="space-y-4">
                            <input type="hidden" id="groupId">
                            <div>
                                <label for="groupNumber" class="block text-sm font-medium text-slate-600">Nº do Grupo (3 dígitos)</label>
                                <input type="text" id="groupNumber" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Ex: 400" required>
                            </div>
                            <div>
                                <label for="groupName" class="block text-sm font-medium text-slate-600">Nome do Grupo</label>
                                <input type="text" id="groupName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
                            </div>
                            <div class="flex flex-col gap-3">
                                <button type="submit" class="w-full bg-blue-800 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                                    <i data-lucide="save" class="w-5 h-5"></i>
                                    Salvar Grupo
                                </button>
                                <button type="button" id="cancelGroupEdit" class="w-full bg-white hover:bg-slate-50 text-slate-700 font-medium py-2 px-4 rounded-lg border border-gray-300 shadow-sm transition-colors hidden">
                                    Cancelar Edição
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Card de Sincronização Padrão -->
                    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                        <h3 class="text-lg font-semibold text-slate-700 mb-3">Sincronizar Grupos</h3>
                        <p class="text-sm text-slate-600 mb-4">
                            Clique para carregar a lista padrão.
                            Isso também corrigirá numerações antigas (6 dígitos) para o novo padrão (3 dígitos).
                        </p>
                        <button id="syncDefaultGroups" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                            <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                            Sincronizar / Corrigir
                        </button>
                    </div>

                    <!-- NOVO: Card de Importação CSV -->
                    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="p-2 bg-indigo-100 rounded-full text-indigo-600">
                                <i data-lucide="file-spreadsheet" class="w-5 h-5"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-slate-700">Importar CSV</h3>
                        </div>
                        <p class="text-sm text-slate-600 mb-4">
                            Importe uma lista personalizada.<br>
                            <strong>Coluna A:</strong> Nº do Grupo<br>
                            <strong>Coluna B:</strong> Nome do Grupo
                        </p>
                        <input type="file" id="csvFileInput" accept=".csv" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 mb-4 border border-gray-200 rounded-lg"/>
                        <button id="btnProcessImport" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                            <i data-lucide="upload" class="w-5 h-5"></i>
                            Processar Arquivo
                        </button>
                    </div>

                </div>

                <!-- Coluna da Direita: Lista de Grupos Cadastrados -->
                <div class="md:col-span-2">
                    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                        <div class="flex justify-between items-center mb-4">
                             <h3 class="text-lg font-semibold text-slate-700">Grupos Cadastrados</h3>
                             <div class="flex items-center gap-2">
                                <i data-lucide="search" class="w-5 h-5 text-gray-400"></i>
                                <input type="text" id="filterGroups" placeholder="Filtrar grupos..." class="border border-gray-300 rounded-md px-3 py-2 w-64 focus:outline-none focus:ring-2 focus:ring-blue-500">
                             </div>
                        </div>
                       
                        <div class="max-h-[800px] overflow-y-auto border border-gray-200 rounded-lg">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-slate-50 sticky top-0 z-10">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Nº</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Nome do Grupo</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-32">Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="groupsTable" class="bg-white divide-y divide-gray-200">
                                    <!-- Linhas inseridas por JS -->
                                    <tr>
                                        <td colspan="3" class="px-6 py-4 text-center text-gray-500">Carregando...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aba: Análise de Demandas (Admin - Restrito) -->
        <div id="tab-analise" class="tab-content space-y-6 hidden">
            <!-- Cabeçalho com Botão de Exportar -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                <div>
                    <h2 class="text-2xl font-semibold text-slate-700">Painel de Consolidação</h2>
                    <p class="text-sm text-slate-500">Visão geral e exportação de dados.</p>
                </div>
                <button id="exportReportButton" class="bg-green-700 hover:bg-green-600 text-white font-medium px-5 py-2 rounded-lg shadow-sm transition-colors flex items-center gap-2">
                    <i data-lucide="download" class="w-5 h-5"></i>
                    Exportar Relatório (CSV)
                </button>
            </div>

            <!-- Métricas Principais -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 flex items-center gap-4">
                    <div class="p-3 rounded-full bg-blue-100 text-blue-700">
                        <i data-lucide="list-checks" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-sm font-medium text-slate-500">Total de Grupos</div>
                        <div id="metricTotalGroups" class="text-3xl font-bold text-slate-800">0</div>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 flex items-center gap-4">
                    <div class="p-3 rounded-full bg-green-100 text-green-700">
                        <i data-lucide="check-circle" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-sm font-medium text-slate-500">Grupos com Demanda</div>
                        <div id="metricDemandGroups" class="text-3xl font-bold text-slate-800">0</div>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 flex items-center gap-4">
                    <div class="p-3 rounded-full bg-orange-100 text-orange-700">
                        <i data-lucide="users" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-sm font-medium text-slate-500">Pedidos Comuns (>2)</div>
                        <div id="metricCommonRequests" class="text-3xl font-bold text-slate-800">0</div>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 flex items-center gap-4">
                    <div class="p-3 rounded-full bg-purple-100 text-purple-700">
                        <i data-lucide="user" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-sm font-medium text-slate-500">Pedidos Específicos (1-2)</div>
                        <div id="metricSpecificRequests" class="text-3xl font-bold text-slate-800">0</div>
                    </div>
                </div>
            </div>

            <!-- Listas de Pedidos Comuns e Específicos -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Pedidos Comuns -->
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                    <h3 class="text-xl font-semibold text-slate-700 mb-4">Pedidos Comuns (> 2 Unidades)</h3>
                    <p class="text-sm text-slate-500 mb-4">Grupos ordenados pela <strong>Prioridade Média</strong> das solicitações.</p>
                    <div class="max-h-[500px] overflow-y-auto border border-gray-200 rounded-lg">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-slate-50 sticky top-0">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-16">Nº</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Grupo</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Unidades</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Prioridade Média</th>
                                </tr>
                            </thead>
                            <tbody id="commonRequestsList" class="bg-white divide-y divide-gray-200">
                                <tr><td colspan="4" class="p-4 text-center text-slate-500">Calculando...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pedidos Específicos -->
                <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                    <h3 class="text-xl font-semibold text-slate-700 mb-4">Pedidos Específicos (1-2 Unidades)</h3>
                    <p class="text-sm text-slate-500 mb-4">Grupos ordenados pela <strong>Prioridade Média</strong> das solicitações.</p>
                    <div class="max-h-[500px] overflow-y-auto border border-gray-200 rounded-lg">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-slate-50 sticky top-0">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-16">Nº</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Grupo</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Unidades</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-24">Prioridade Média</th>
                                </tr>
                            </thead>
                            <tbody id="specificRequestsList" class="bg-white divide-y divide-gray-200">
                                <tr><td colspan="4" class="p-4 text-center text-slate-500">Calculando...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Detalhe por Unidade -->
            <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
                <h3 class="text-xl font-semibold text-slate-700 mb-4">Detalhamento por Unidade</h3>
                <div class="max-h-[500px] overflow-y-auto border border-gray-200 rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-slate-50 sticky top-0">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Unidade</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Grupos Solicitados</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Soma das Prioridades</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Prioridade Média</th>
                            </tr>
                        </thead>
                        <tbody id="unitDetailsList" class="bg-white divide-y divide-gray-200">
                            <tr><td colspan="4" class="p-4 text-center text-slate-500">Calculando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Modal de Perfil/Unidade -->
    <div id="profileModal" class="fixed inset-0 bg-gray-600 bg-opacity-75 flex items-center justify-center z-50 hidden no-print">
        <div class="bg-white rounded-xl shadow-2xl p-8 m-4 max-w-lg w-full">
            <h2 class="text-2xl font-semibold text-slate-700 mb-2">Bem-vindo!</h2>
            <p class="text-slate-600 mb-6">Por favor, selecione sua unidade (Secretaria/Setor) para continuar.</p>
            <form id="profileForm" class="space-y-4">
                <div>
                    <label for="unitNameSelect" class="block text-sm font-medium text-slate-600">Minha Unidade</label>
                    <select id="unitNameSelect" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
                        <option value="">Selecione...</option>
                        <!-- Opções adicionadas por JS -->
                    </select>
                </div>
                <div class="flex justify-end gap-4 pt-4">
                    <button type="button" id="profileModalCancel" class="bg-white hover:bg-slate-50 text-slate-700 font-medium py-2 px-4 rounded-lg border border-gray-300 shadow-sm transition-colors">Cancelar</button>
                    <button type="submit" class="bg-blue-800 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors">Salvar e Continuar</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Modal de Confirmação de Deleção -->
    <div id="deleteConfirmModal" class="fixed inset-0 bg-gray-600 bg-opacity-75 flex items-center justify-center z-50 hidden no-print">
        <div class="bg-white rounded-xl shadow-2xl p-8 m-4 max-w-md w-full">
            <div class="flex items-center gap-3 mb-4">
